+static std::vector<uint8_t> readPngBytes(std::string const &path) {
+	FILE *file = fopen(path.c_str(), "rb");
+	if (!file) {
+		fatal("Failed to open input image (\"%s\"): %s", path.c_str(), strerror(errno));
+	}
+
+	std::vector<uint8_t> data;
+	std::array<uint8_t, 64 * 1024> buffer;
+	for (;;) {
+		size_t const count = fread(buffer.data(), 1, buffer.size(), file);
+		data.insert(data.end(), buffer.begin(), buffer.begin() + count);
+		if (count != buffer.size()) {
+			if (ferror(file)) {
+				int const error = errno;
+				fclose(file);
+				fatal("Failed to read input image (\"%s\"): %s", path.c_str(), strerror(error));
+			}
+			break;
+		}
+	}
+
+	fclose(file);
+	return data;
+}
